class Solution {
    public int carFleet(int target, int[] position, int[] speed) {
       int n= position.length;
       double[][] jus= new double[n][2];

       for(int i=0;i<n; i++){
        jus[i][0]=position[i];
        jus[i][1]=(double)(target-position[i])/speed[i];
} 
    
    Arrays.sort(jus,(a,b)-> Double.compare(b[0],a[0]));
    int count=0;
    double pretime=0;
    for(double[] car:jus){
        if(car[1]>pretime){
            count++;
            pretime=car[1];
        }
    }
    return count;
    }
}
